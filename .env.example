APP_NAME="NOC Barito Utara"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kuma.baritoutarakab.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── Database: container MariaDB existing (mikrotik-monitor-db) ──────────────
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=noc_barutara
DB_USERNAME=noc
DB_PASSWORD=

# Sesi: cookie HttpOnly + same_site=lax; 24 jam
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# true BILA diakses via HTTPS (reverse proxy); false untuk uji HTTP lokal
SESSION_SECURE_COOKIE=false

# IP reverse-proxy TERCAYA (pisahkan koma) — X-Real-IP hanya dihormati dari sini
# 192.168.101.42 = nginx-proxy-manager → wajib agar skema https terbaca
# (kalau kosong, asset/CSS dirender http:// dan diblokir browser mixed-content)
TRUST_PROXIES=192.168.101.42

# Seeder admin awal (min. 12 karakter)
WEB_USERNAME=admin
WEB_PASSWORD=change-me-min-12-chars

# Telegram webhook (bisa juga diatur dari menu Pengaturan)
TELEGRAM_TIKET_TOKEN=
TELEGRAM_TIKET_CHAT_ID=
TELEGRAM_JARINGAN_TOKEN=
TELEGRAM_JARINGAN_CHAT_ID=

# Poller jaringan: interval detik (30 = keputusan user)
POLL_INTERVAL=30
# Retensi metrics dalam hari
METRICS_RETENTION_DAYS=30

# SNMP default (bisa ditimpa per-perangkat)
SNMP_VERSION=2c
SNMP_COMMUNITY=public
SNMP_PORT=161
SNMP_TIMEOUT=3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
